# CollectAPI Credentials
COLLECTAPI_KEY=your_collectapi_key_here

# Database Configuration
# Supports PostgreSQL (postgresql://user:password@host:port/dbname) or SQLite (sqlite:///gas_prices.db)
DATABASE_URL=sqlite:///gas_prices.db

# Granular PostgreSQL parameters (fallback if DATABASE_URL is unset)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gas_prices
